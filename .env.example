# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ubb_flow_trust

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_DIFFERENT

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379

# Storage (local | s3 | minio)
STORAGE_TYPE=local

# S3/MinIO (only if STORAGE_TYPE=s3 or minio)
S3_REGION=eu-west-3
S3_BUCKET=ubb-flow-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Google Vision API (optional, for OCR)
GOOGLE_VISION_API_KEY=

# ─── Frontend build ───────────────────────────────────────────────────────────
VITE_API_URL=http://yourdomain.com
