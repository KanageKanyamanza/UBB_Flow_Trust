# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=trust_lane

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_DIFFERENT

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379

# Storage (local | s3 | minio)
STORAGE_TYPE=local

# S3/MinIO (only if STORAGE_TYPE=s3 or minio)
S3_REGION=eu-west-3
S3_BUCKET=trust-lane-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Google Vision API (optional, for OCR)
GOOGLE_VISION_API_KEY=

# ─── Admin Panel ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=CHANGE_ME_64_CHAR_HEX_ADMIN
ADMIN_JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_ADMIN_REFRESH

# Premier compte admin (utilisé par npm run seed:admin)
ADMIN_SEED_EMAIL=admin@trustlane.app
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SEED_FIRSTNAME=Super
ADMIN_SEED_LASTNAME=Admin

# ─── Frontend build ───────────────────────────────────────────────────────────
VITE_API_URL=http://yourdomain.com

# ─── Admin panel build ────────────────────────────────────────────────────────
# Inlined into the admin JS bundle at build time. Leave as /api (default) for
# the self-hosted docker-compose deployment: the outer Nginx proxies same-origin
# /api/* requests to the backend, so the admin panel never needs a fully
# qualified URL. Only override if the admin panel is served from a different
# origin than the one Nginx (config/nginx.conf) is routing for.
ADMIN_VITE_API_URL=/api
