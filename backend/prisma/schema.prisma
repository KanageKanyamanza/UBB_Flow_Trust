generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String               @id @default(uuid())
  name              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          Account[]
  alerts            Alert[]
  auditLogs         AuditLog[]
  checklists        Checklist[]
  consentGrants     ConsentGrant[]
  documents         Document[]
  forecastSnapshots ForecastSnapshot[]
  publicProfile     PublicProfile?
  flowScores        ReadinessScoreFlow[]
  recurringRules    RecurringRule[]
  smeProfile        SmeProfile?
  budget            Budget[]
  transactions      Transaction[]
  trustScores       TrustScore[]
  users             User[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  firstName    String?
  lastName     String?
  role         Role         @default(OWNER)
  orgId        String
  accountId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
  account      Account?     @relation(fields: [accountId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  refreshToken String?
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         String
  currency     String        @default("XAF")
  balance      Decimal       @default(0)
  orgId        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization  @relation(fields: [orgId], references: [id])
  transactions Transaction[]
  users        User[]
  budgets      Budget[]
}

model Transaction {
  id            String         @id @default(uuid())
  occurredAt    DateTime
  direction     TxnDirection
  amount        Decimal
  currency      String         @default("XAF")
  method        TxnMethod
  category      TxnCategory
  counterparty  String?
  notes         String?
  orgId         String
  accountId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  evidenceFiles EvidenceFile[]
  account       Account        @relation(fields: [accountId], references: [id])
  organization  Organization   @relation(fields: [orgId], references: [id])
}

model RecurringRule {
  id           String       @id @default(uuid())
  name         String
  amount       Decimal
  direction    TxnDirection
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
}

model ForecastSnapshot {
  id           String       @id @default(uuid())
  horizonDays  Int
  data         Json
  confidence   Float
  orgId        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
}

model ReadinessScoreFlow {
  id           String       @id @default(uuid())
  score        Int
  reasonCodes  String[]
  orgId        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
}

model SmeProfile {
  id               String            @id @default(uuid())
  legalName        String
  registrationNo   String?
  taxId            String?
  country          String?
  address          String?
  governanceType   String?
  industry         String?
  description      String?
  website          String?
  email            String?
  phone            String?
  foundedDate      DateTime?
  employeeCount    Int?
  annualTurnover   Decimal?          @db.Decimal(15, 2)
  currency         String            @default("XAF")
  orgId            String            @unique
  updatedAt        DateTime          @updatedAt
  beneficialOwners BeneficialOwner[]
  organization     Organization      @relation(fields: [orgId], references: [id])
}

model BeneficialOwner {
  id           String     @id @default(uuid())
  name         String
  role         String?
  ownershipPct Float?
  idType       String?
  idNumber     String?
  nationality  String?
  email        String?
  phone        String?
  address      String?
  birthDate    DateTime?
  profileId    String
  smeProfile   SmeProfile @relation(fields: [profileId], references: [id])
}

model Document {
  id             String            @id @default(uuid())
  type           String
  name           String
  status         DocStatus         @default(DRAFT)
  orgId          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  checklistItems ChecklistItem[]
  organization   Organization      @relation(fields: [orgId], references: [id])
  versions       DocumentVersion[]
}

model DocumentVersion {
  id         String    @id @default(uuid())
  docId      String
  fileUrl    String
  fileName   String
  fileSize   Int
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  document   Document  @relation(fields: [docId], references: [id])
}

model Checklist {
  id           String          @id @default(uuid())
  market       String
  orgId        String
  createdAt    DateTime        @default(now())
  organization Organization    @relation(fields: [orgId], references: [id])
  items        ChecklistItem[]
}

model ChecklistItem {
  id          String              @id @default(uuid())
  requirement String
  status      ChecklistItemStatus @default(MISSING)
  checklistId String
  docId       String?
  checklist   Checklist           @relation(fields: [checklistId], references: [id])
  document    Document?           @relation(fields: [docId], references: [id])
}

model ChecklistTemplate {
  id           String   @id @default(uuid())
  market       String   @unique // "LOCAL" or "EU"
  requirements String[]
  createdAt    DateTime @default(now())
}

model TrustScore {
  id           String       @id @default(uuid())
  score        Int
  reasonCodes  String[]
  orgId        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
}

model PublicProfile {
  id           String       @id @default(uuid())
  slug         String       @unique
  isActive     Boolean      @default(false)
  orgId        String       @unique
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
}

model ConsentGrant {
  id           String       @id @default(uuid())
  partnerName  String
  purpose      String
  scope        String
  expiresAt    DateTime
  orgId        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
}

model Alert {
  id           String        @id @default(uuid())
  type         String
  severity     AlertSeverity
  message      String
  isAck        Boolean       @default(false)
  orgId        String
  createdAt    DateTime      @default(now())
  organization Organization  @relation(fields: [orgId], references: [id])
}

model AuditLog {
  id           String       @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  oldData      Json?
  newData      Json?
  userId       String?
  orgId        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
}

model EvidenceFile {
  id          String      @id @default(uuid())
  txnId       String
  fileUrl     String
  fileName    String
  createdAt   DateTime    @default(now())
  transaction Transaction @relation(fields: [txnId], references: [id])
}

enum Role {
  OWNER
  FINANCE
  OPS
  ADVISOR
  PARTNER_READONLY
  AUDITOR
  AGENT
}

enum TxnDirection {
  IN
  OUT
}

enum TxnMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CREDIT
  CHEQUE
  OTHER
}

enum TxnCategory {
  SALES
  COGS
  PAYROLL
  RENT_UTILITIES
  TRANSPORT
  TAX
  DEBT_SERVICE
  CAPEX
  OWNER_DRAW
  FEES
  MARKETING
  OTHER
}

enum DocStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum ChecklistItemStatus {
  MISSING
  IN_REVIEW
  PASS
  FAIL
  NOT_APPLICABLE
}

enum AlertSeverity {
  INFO
  WARN
  CRITICAL
}

model Budget {
  id           String       @id @default(uuid())
  category     TxnCategory
  amount       Decimal
  period       String       @default("MONTHLY")
  orgId        String
  accountId    String?
  account      Account?     @relation(fields: [accountId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orgId, category, period, accountId])
}
